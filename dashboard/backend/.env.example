# dashboard/backend/.env
# 로컬 개발용. 서버(Docker) 배포에서는 DATABASE_URL을 docker-compose가 덮어쓰므로
# 이 파일에는 외부 API 키만 채워두면 된다.

# 로컬 실행용 DB 접속 문자열 (Docker 배포 시 compose가 override)
DATABASE_URL=postgresql+psycopg://dashboard_app:비밀번호@localhost:5432/samyang_dashboard

# CORS 허용 오리진 정규식. 비워두면 localhost + *.vercel.app 이 기본으로 허용된다.
# Vercel 커스텀 도메인을 붙였다면 여기에 추가한다.
# CORS_ALLOW_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+|https://.*\.vercel\.app|https://dashboard\.example\.com

# --- 외부 API 키 (없으면 해당 지표만 error 상태가 되고 서버는 정상 동작) ---
EIA_API_KEY=
KOSIS_API_KEY=
DATA_GO_KR_KEY=
ECOS_API_KEY=
FRED_API_KEY=
REALTY_API_KEY=

# --- 노트북(수집 스크립트)에서 쓰는 키 ---
DART_API_KEY=
KAMIS_API_ID=
KAMIS_API_KEY=
OILPRICE_API_KEY=
FIS_API_KEY=
