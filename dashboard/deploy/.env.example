# dashboard/deploy/.env  (이 파일을 .env로 복사해서 값을 채운다)
# docker-compose.yml이 읽는 값들. 절대 커밋하지 않는다.

# --- 도메인 ---------------------------------------------------------------
# 도메인을 아직 안 샀다면 sslip.io를 쓰면 된다. 서버 공인 IP가 203.0.113.5라면
#   API_DOMAIN=api.203-0-113-5.sslip.io
# 처럼 쓰면 DNS 설정 없이 바로 Let's Encrypt 인증서를 받을 수 있다.
# 나중에 진짜 도메인을 사면 이 세 줄만 바꾸고 init-letsencrypt.sh를 다시 돌린다.
API_DOMAIN=api.203-0-113-5.sslip.io
MINIO_DOMAIN=s3.203-0-113-5.sslip.io
MINIO_CONSOLE_DOMAIN=minio.203-0-113-5.sslip.io

# Let's Encrypt 만료 알림을 받을 메일 주소
LETSENCRYPT_EMAIL=you@example.com

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=samyang_dashboard
POSTGRES_USER=dashboard_app
POSTGRES_PASSWORD=

# --- MinIO ----------------------------------------------------------------
# 3자 이상 / 8자 이상. 콘솔 로그인 계정이자 S3 액세스 키로 쓰인다.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# --- CORS -----------------------------------------------------------------
# 비워두면 localhost + *.vercel.app + *.onrender.com 이 허용된다.
# Vercel에 커스텀 도메인을 붙였다면 그 도메인을 정규식에 추가한다.
CORS_ALLOW_ORIGIN_REGEX=
